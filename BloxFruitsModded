--------------------------------------------------------------------------------
-- HELPER FUNCTIONS
--------------------------------------------------------------------------------
local function getCharacter()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character
end

local function isBloxFruit(model)
    local nameLower = model.Name:lower()
    for _, kw in ipairs(FRUIT_KEYWORDS) do
        if nameLower:find(kw) then
            return true
        end
    end
    return false
end

local function getClosestNPC()
    local char = getCharacter()
    if not char then return nil, nil end
    local hrp = char.HumanoidRootPart

    local closestModel, closestHRP = nil, nil
    local shortestDist = SETTINGS.ScanRadius

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char then
            if TARGET_NPC_LOOKUP[obj.Name:lower()] or obj.Name:lower():find("bandit") or obj.Name:lower():find("pirate") then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local eHRP = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                
                if hum and eHRP and hum.Health > 0 then
                    local dist = (hrp.Position - eHRP.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestModel = obj
                        closestHRP = eHRP
                    end
                end
            end
        end
    end

    return closestModel, closestHRP
end

local function autoEquipWeapon()
    local char = getCharacter()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end

    if not char:FindFirstChildOfClass("Tool") then
        local tool = backpack:FindFirstChildOfClass("Tool")
        if tool then
            char.Humanoid:EquipTool(tool)
        end
    end
end

local function attackWithTool()
    local char = getCharacter()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    end
end

