local function createToggle(text, order, flagName, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(26, 26, 36)
    btn.Text = "  [OFF] " .. text
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = order
    btn.Parent = Scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(45, 45, 60)

    btn.MouseButton1Click:Connect(function()
        Flags[flagName] = not Flags[flagName]
        local state = Flags[flagName]
        
        btn.Text = state and ("  [ON] " .. text) or ("  [OFF] " .. text)
        btn.TextColor3 = state and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(200, 200, 200)
        btn.BackgroundColor3 = state and Color3.fromRGB(18, 48, 36) or Color3.fromRGB(26, 26, 36)
        stroke.Color = state and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(45, 45, 60)

        if callback then callback(state) end
    end)
    return btn
end

