-- 1. Auto Farm All Mobs
createToggle("AUTO-FARM ALL BLOX FRUITS NPCS", 1, "AutoFarm", function(enabled)
    if enabled then
        Connections.AutoFarm = RunService.Heartbeat:Connect(function()
            local char = getCharacter()
            if not char then return end

            local _, enemyHRP = getClosestNPC()
            if enemyHRP then
                char.HumanoidRootPart.CFrame = enemyHRP.CFrame * CFrame.new(0, SETTINGS.FarmHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                if Flags.AutoEquip then autoEquipWeapon() end
                attackWithTool()
            end
        end)
    else
        if Connections.AutoFarm then Connections.AutoFarm:Disconnect() Connections.AutoFarm = nil end
    end
end)

-- 2. Auto Collect Spawns & Devil Fruits
createToggle("AUTO-COLLECT & SNIPE ALL FRUITS", 2, "AutoPickupFruit", function(enabled)
    if enabled then
        Connections.AutoPickupFruit = RunService.Heartbeat:Connect(function()
            local char = getCharacter()
            if not char then return end

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("Tool") then
                    if isBloxFruit(obj) then
                        local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                        if handle then
                            char.HumanoidRootPart.CFrame = handle.CFrame * CFrame.new(0, 2, 0)
                            if typeof(firetouchinterest) == "function" then
                                firetouchinterest(char.HumanoidRootPart, handle, 0)
                                firetouchinterest(char.HumanoidRootPart, handle, 1)
                            end
                        end
                    end
                end
            end
        end)
    else
        if Connections.AutoPickupFruit then Connections.AutoPickupFruit:Disconnect() Connections.AutoPickupFruit = nil end
    end
end)

